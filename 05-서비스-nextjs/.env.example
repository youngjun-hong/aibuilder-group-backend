# ─────────────────────────────────────────────────────────────
#  이 파일을 .env.local 로 복사한 뒤 값만 바꾸면 연동이 켜집니다.
#    cp .env.example .env.local
#
#  .env.local 은 git 에 올라가지 않습니다(.gitignore 의 .env*.local).
#  비워두면 연동만 꺼지고 사이트는 그대로 동작합니다 — 값 없이도 화면이 죽지 않게 짰습니다.
#  NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저로 내려갑니다. 비밀키를 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# pluug 리드 폼 주소
#   문의 데이터는 우리 DB 에 저장하지 않고 pluug 가 받습니다.
#   pluug 대시보드 > 폼 > 공유 링크에서 복사하세요.
#   ⚠ www 를 붙인 정규 주소를 쓰세요. pluuug.com/form/... 은 301 로 www 에 넘기는데
#     리다이렉트를 한 번 더 타면 그만큼 이탈 지점이 늘고 UTM 전달도 한 단계 더 거칩니다.
#   ⚠ pluug 쪽 "제출 후 이동 링크"를 이 사이트의 /submit 으로 맞춰야
#     전환 측정이 성립합니다.
NEXT_PUBLIC_PLUUG_FORM_URL=https://www.pluuug.com/form/여기에_폼_ID

# 채널톡 플러그인 키
#   채널톡 > 채널 설정 > 보안 및 개발 > 플러그인 키
#   ⚠ 키가 틀리면 boot 콜백이 아예 오지 않습니다. 에러도 안 납니다(실측).
#     바꾼 뒤에는 반드시 런처를 눌러 메신저가 실제로 열리는지 확인하세요.
NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=여기에_플러그인_키

# pluug 로 넘길 utm_source 고정값. 보통 바꿀 일 없습니다.
NEXT_PUBLIC_UTM_SOURCE=ai-builder-group

# 실도메인이 정해지면 채우세요. 비우면 Vercel 프로덕션 도메인을 자동으로 씁니다.
#   og:url · og:image · canonical 이 모두 이 값을 따릅니다.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ─────────────────────────────────────────────────────────────
#  분석 · SEO — docs/analytics-seo-setup.md 에 값 구하는 절차 전체가 있습니다.
#  전부 비워둬도 사이트는 그대로 동작합니다 (GA4 스크립트만 안 실림 · 메타태그만 안 나감).
# ─────────────────────────────────────────────────────────────

# GA4 측정 ID. GA4 관리 > 데이터 스트림 > 웹 스트림.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 속성 ID(측정 ID와 다른 값, 숫자만). GA4 관리 > 속성 설정.
#   관리자 대시보드(/admin)의 실트래픽 그래프에만 쓰입니다.
# GA4_PROPERTY_ID=123456789

# 구글 서치콘솔 소유 확인 메타태그 값. 서치콘솔 > 속성 추가 > HTML 태그 방식으로 확인할 때
#   나오는 <meta name="google-site-verification" content="이 값"> 의 content 만 붙여넣으세요.
# GOOGLE_SITE_VERIFICATION=여기에_확인_코드

# 네이버 서치어드바이저 소유 확인 메타태그 값. 서치어드바이저 > 사이트 등록 > HTML 태그 방식.
#   ⚠ 네이버는 공개 리포팅 API가 없어 대시보드에 실측 그래프를 못 넣습니다.
#     소유 확인 · 사이트맵 제출까지만 여기서 하고, 지표는 서치어드바이저에서 직접 봐야 합니다.
# NAVER_SITE_VERIFICATION=여기에_확인_코드

# GCP 서비스 계정 키(JSON 전체를 한 줄로). 관리자 대시보드의 GA4·서치콘솔 실트래픽 그래프에
#   쓰입니다. 서비스 계정을 GA4 속성에 뷰어로, 서치콘솔 속성에 사용자로 추가해야 합니다.
#   비어 있으면 대시보드가 "연동 필요" 카드만 보여주고 죽지 않습니다.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# 서치콘솔에 등록한 속성 식별자 그대로 (URL 접두어 방식이면 "https://example.com/",
#   도메인 속성이면 "sc-domain:example.com").
# GOOGLE_SEARCH_CONSOLE_SITE_URL=https://example.com/
